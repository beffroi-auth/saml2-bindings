{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 60,
    "logs": {
        "text": ".ci-tools/infection.txt"
    },
    "mutators": {
        "@default": true,
        "Throw_": {
            "ignoreSourceCodeByRegex": [
                "throw new LogicException\\('zlib could not start an inflation \\(section 6\\.1\\)\\.'\\);",
                "throw new LogicException\\('zlib could not deflate the message \\(section 6\\.3\\)\\.'\\);"
            ]
        }
    },
    "phpUnit": {
        "configDir": ".ci-tools"
    }
}
