# PHPStan at level max, with no baseline, ever: every finding is fixed in the code or refused in the review.
#
# The extensions come from the phpqa image (/tools/.composer/vendor-bin/phpstan), which is where %rootDir% points;
# PHPUnit's classes are scanned from the image's PHPUnit install. Section 8 of the specification is enforced here:
# ekino/phpstan-banned-code for the statements and operators it knows (echo, eval, exit, print, backticks, @) and the
# defaults of its function list, the four rules of tests/PhpStan for the rest, since that tool bans function names as
# they are written and whole node types, not classes, methods, prefixes, variables or calls confined to a file. What
# saml2-model bans (model.md section 8) is copied as it is, banned in src/ and in tests/ alike; what section 8 adds for
# this package is banned in src/, and in tests/ too unless a test has a use for it, which its entry says.
parameters:
	level: max
	scanDirectories:
		- %rootDir%/../../../../phpunit/vendor
	paths:
		- %currentWorkingDirectory%/src
		- %currentWorkingDirectory%/tests
	# the fixtures are data, and the interoperability projects of section 9.5 are throwaway Composer projects run in
	# their own containers against libraries that are not dependencies of this package
	excludePaths:
		- %currentWorkingDirectory%/tests/Fixture/*
		- %currentWorkingDirectory%/tests/Interop/*
	checkUninitializedProperties: true
	treatPhpDocTypesAsCertain: false
	banned_code:
		non_ignorable: true
		use_from_tests: true
		nodes:
			# echo and print: the package writes no output (B-13, section 8)
			-
				type: Stmt_Echo
				functions: null
			-
				type: Expr_Eval
				functions: null
			-
				type: Expr_Exit
				functions: null
			-
				type: Expr_Print
				functions: null
			-
				type: Expr_ShellExec
				functions: null
			# the @ operator: an error is never silenced (section 8)
			-
				type: Expr_ErrorSuppress
				functions: null
			-
				type: Expr_FuncCall
				functions:
					# the defaults of the extension
					- dd
					- debug_backtrace
					- dump
					- exec
					- passthru
					- phpinfo
					- print_r
					- proc_open
					- shell_exec
					- system
					- var_dump
	# The classes and constants of model.md section 8 (core.md section 8 for the DOM), for BannedNamesRule.
	# \DateTime and \DateTimeImmutable are not here: the types stay, their construction without an explicit time is
	# BannedConstructsRule's. The classes of HTTP are Deptrac's (section 10).
	bannedNames:
		- DOMDocument
		- DOMXPath
		- DOMImplementation
		- Dom\XPath
		- SimpleXMLElement
		- XMLReader
		- XMLWriter
		- LIBXML_NOENT
		- LIBXML_DTDLOAD
		- LIBXML_DTDATTR
		- LIBXML_DTDVALID
		- LIBXML_XINCLUDE
		- LIBXML_PARSEHUGE
		- LIBXML_NOBLANKS
		- LIBXML_NOCDATA
		- ReflectionClass
		- ReflectionObject
		- ReflectionMethod
		- ReflectionProperty
		- ReflectionFunction
		- ReflectionNamedType
		# a boolean of a message is one of its four lexical forms, compared as a string (M-6)
		- FILTER_VALIDATE_BOOL
		- FILTER_VALIDATE_BOOLEAN
	# The methods and functions never called, for BannedCallsRule; a name ending with * bans the prefix.
	bannedMethods:
		# I-9, I-11: no ID lookup, no search of descendants (M-4)
		- getElementById
		- setIdAttribute
		- setIdAttributeNS
		- setIdAttributeNode
		- getElementsByTagName
		- getElementsByTagNameNS
		- querySelector
		- querySelectorAll
		# I-4, I-13, I-15: Core loads, builds, canonicalizes and serializes, the package never does (B-10)
		- createFromString
		- createFromFile
		- createEmpty
		- C14N
		- C14NFile
		- saveXml
		- saveXmlFile
		# core.md section 6.6, I-1, I-2, core.md section 11
		- importNode
		- adoptNode
		- xinclude
		- validate
		- schemaValidate
		- schemaValidateSource
		- relaxNgValidate
		- relaxNgValidateSource
		- createEntityReference
	bannedFunctions:
		# core.md section 8: no entity loader, no second parser (I-2, I-4)
		- libxml_set_external_entity_loader
		- libxml_disable_entity_loader
		- simplexml_*
		- xml_parser_create
		- xml_parser_create_ns
		# the security stance: no silencing, no dynamic call
		- error_reporting
		- call_user_func
		- call_user_func_array
		# the package verifies and signs through Dsig (section 2)
		- openssl_*
		- hash_hmac
		# every reading of the machine's clock: the package needs no time, the tests read the frozen clock
		- time
		- microtime
		- hrtime
		- date
		- gmdate
		- idate
		- getdate
		- localtime
		- gettimeofday
		- mktime
		- gmmktime
		- strtotime
		- date_create
		- date_create_immutable
		# random_bytes() is the randomness; the other generators of the Mersenne Twister are banned with them
		- rand
		- mt_rand
		- srand
		- mt_srand
		- uniqid
		- lcg_value
		- shuffle
		- str_shuffle
		- array_rand
		# a boolean is never cast (M-6)
		- boolval
		- settype
		# section 8, B-1, B-13: a second parser of the request, and HTTP itself, are the consumer's
		- parse_str
		- http_build_query
		- parse_url
		- filter_input
		- filter_input_array
		- header
		- headers_list
		- setcookie
		# section 8: the package writes no output
		- printf
	# The calls section 8 confines to named files, for BannedCallsRule: a path ending with / allows its whole
	# directory. The receiver of a confined method is not looked at: validateAuthenticatedByBinding() is a method of the
	# model's validators, and the four Received* classes are the only ones that call it (B-5).
	confinedCalls:
		# B-8: the percent codec is Internal\Percent; the tests build hostile and lowercase escapes with PHP's own
		-
			function: urldecode
			allowedIn: [src/Internal/Percent.php, tests/]
		-
			function: rawurldecode
			allowedIn: [src/Internal/Percent.php, tests/]
		-
			function: urlencode
			allowedIn: [src/Internal/Percent.php, tests/]
		-
			function: rawurlencode
			allowedIn: [src/Internal/Percent.php, tests/]
		# B-8: base64 is decoded in Internal\Base64 only, and always strictly (BannedCallsRule refuses a call without
		# its strict flag wherever it is allowed)
		-
			function: base64_decode
			allowedIn: [src/Internal/Base64.php, tests/]
		# B-7, B-8: inflation is Internal\Inflater's, bounded while it runs; the tests build bombs and wrapped streams
		-
			function: gzinflate
			allowedIn: [src/Internal/Inflater.php, tests/]
		-
			function: gzuncompress
			allowedIn: [src/Internal/Inflater.php, tests/]
		-
			function: gzdecode
			allowedIn: [src/Internal/Inflater.php, tests/]
		-
			function: zlib_decode
			allowedIn: [src/Internal/Inflater.php, tests/]
		-
			function: inflate_init
			allowedIn: [src/Internal/Inflater.php, tests/]
		-
			function: inflate_add
			allowedIn: [src/Internal/Inflater.php, tests/]
		# B-8: deflation is Internal\Deflater's; the tests build bombs and the zlib and gzip wrappers B-8 refuses
		-
			function: gzdeflate
			allowedIn: [src/Internal/Deflater.php, tests/]
		-
			function: gzcompress
			allowedIn: [src/Internal/Deflater.php, tests/]
		-
			function: gzencode
			allowedIn: [src/Internal/Deflater.php, tests/]
		-
			function: zlib_encode
			allowedIn: [src/Internal/Deflater.php, tests/]
		-
			function: deflate_init
			allowedIn: [src/Internal/Deflater.php, tests/]
		-
			function: deflate_add
			allowedIn: [src/Internal/Deflater.php, tests/]
		# section 8: the environment is the consumer's; the oracle of section 9.1 reads its directory from it, as the
		# model's does
		-
			function: getenv
			allowedIn: [tests/]
		# B-5: the binding's authentication is this package's word, said by the four Received* classes and nobody else
		-
			method: validateAuthenticatedByBinding
			allowedIn:
				- src/ReceivedAuthnRequest.php
				- src/ReceivedLogoutRequest.php
				- src/ReceivedLogoutResponse.php
				- src/ReceivedResponse.php
	# Section 8, B-13: the superglobals, for BannedConstructsRule. The package takes strings and arrays. $GLOBALS holds
	# every other one under another name ($GLOBALS['_GET']), and is banned with them.
	bannedVariables:
		- _GET
		- _POST
		- _REQUEST
		- _SERVER
		- _COOKIE
		- _FILES
		- _ENV
		- GLOBALS

parametersSchema:
	bannedNames: listOf(string())
	bannedMethods: listOf(string())
	bannedFunctions: listOf(string())
	confinedCalls: listOf(anyOf(
		structure([method: string(), allowedIn: listOf(string())]),
		structure([function: string(), allowedIn: listOf(string())])
	))
	bannedVariables: listOf(string())

services:
	-
		class: Beffroi\Saml2\Bindings\Tests\PhpStan\BannedNamesRule
		arguments:
			names: %bannedNames%
		tags:
			- phpstan.rules.rule
	-
		class: Beffroi\Saml2\Bindings\Tests\PhpStan\BannedCallsRule
		arguments:
			methods: %bannedMethods%
			functions: %bannedFunctions%
			confined: %confinedCalls%
			workingDirectory: %currentWorkingDirectory%
		tags:
			- phpstan.rules.rule
	# a first-class callable of a banned or confined call is that call (BannedCallablesRule)
	-
		class: Beffroi\Saml2\Bindings\Tests\PhpStan\BannedCallablesRule
		arguments:
			nodeType: PHPStan\Node\FunctionCallableNode
		tags:
			- phpstan.rules.rule
	-
		class: Beffroi\Saml2\Bindings\Tests\PhpStan\BannedCallablesRule
		arguments:
			nodeType: PHPStan\Node\MethodCallableNode
		tags:
			- phpstan.rules.rule
	-
		class: Beffroi\Saml2\Bindings\Tests\PhpStan\BannedCallablesRule
		arguments:
			nodeType: PHPStan\Node\StaticMethodCallableNode
		tags:
			- phpstan.rules.rule
	-
		class: Beffroi\Saml2\Bindings\Tests\PhpStan\BannedConstructsRule
		arguments:
			variables: %bannedVariables%
		tags:
			- phpstan.rules.rule

includes:
	- %rootDir%/conf/bleedingEdge.neon
	- %rootDir%/../../ekino/phpstan-banned-code/extension.neon
	- %rootDir%/../phpstan-deprecation-rules/rules.neon
	- %rootDir%/../phpstan-phpunit/extension.neon
	- %rootDir%/../phpstan-phpunit/rules.neon
	- %rootDir%/../phpstan-strict-rules/rules.neon
